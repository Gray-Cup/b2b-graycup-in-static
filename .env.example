# Copy to .dev.vars (wrangler dev) and/or .env (vite/node). Real values are in
# 1Password / the Cloudflare dashboard — see the sibling sites' secrets.

# Cashfree — shared GrayCup production merchant account. The same secret
# verifies the /api/webhooks/cashfree signature. CASHFREE_ENV=sandbox to test.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=production

# Cloudflare Turnstile — b2b.graycup.in's own widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Discord relays (forms still succeed if unset)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_FEATURE_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=

# D1 (orders + leads) is a Workers binding — see wrangler.jsonc (binding "DB",
# database "graycup-orders"). No connection string needed.
